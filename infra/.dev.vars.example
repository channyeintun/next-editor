# Copy to infra/.dev.vars (git-ignored) for local `wrangler dev`. See
# docs/cloudflare-deploy-guide.md for setup and secret-handling guidance.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Live collaboration needs nothing beyond the sign-in values above: rooms run on
# the Durable Object bindings in infra/wrangler.toml, which `wrangler dev` runs
# locally.

# Optional locally; configure all three in production. QStash runs the signed,
# delayed purge of a closed room: its Durable Object document, R2 assets, and D1
# rows. (Room log compaction is a Durable Object alarm and needs no secret.)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional: room voice chat. Voice stays off (fails closed) unless both are set;
# use a separate Cloudflare Realtime application per environment.
REALTIME_SFU_APP_ID=
REALTIME_SFU_APP_SECRET=

# Optional: private Burmese Studio narration (VoxCPM2 on Modal). All three are
# required, and the signed-in user also needs the studio.burmese-voxcpm2 D1
# feature flag.
VOXCPM2_MODAL_JOBS_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
