# Copy to infra/.dev.vars (git-ignored) for local `wrangler dev`. See
# docs/cloudflare-deploy-guide.md for setup and secret-handling guidance.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Optional fail-open gallery cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required when exercising live collaboration. Production should use a
# dedicated database; local development may explicitly reuse the cache values.
COLLAB_REDIS_REST_URL=
COLLAB_REDIS_REST_TOKEN=
