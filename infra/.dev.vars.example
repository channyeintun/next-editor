# Copy to infra/.dev.vars (git-ignored) for local `wrangler dev`. See
# docs/cloudflare-deploy-guide.md for setup and secret-handling guidance.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Required when exercising live collaboration. Redis is reserved for the
# collaboration/Realtime data plane; the gallery cache uses local Workers KV.
COLLAB_REDIS_REST_URL=
COLLAB_REDIS_REST_TOKEN=

# Optional locally; configure all three in production for signed background
# compaction and delayed room/R2 cleanup.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
