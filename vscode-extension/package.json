{
  "name": "next-recording",
  "displayName": "Next Recording",
  "version": "0.0.1",
  "private": true,
  "description": "Record and replay multi-document VS Code editing sessions.",
  "categories": [
    "Other"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/channyeintun/next-editor",
    "directory": "vscode-extension"
  },
  "publisher": "channyeintun",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun run build:extension && bun run build:webview",
    "build:extension": "node esbuild.mjs --production",
    "build:webview": "vite build",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "test:unit": "vitest run",
    "test:integration": "tsc -p tsconfig.test.json && node dist-test/runTest.js",
    "benchmark:renderer": "node scripts/benchmark-renderer.mjs",
    "package": "node scripts/package-vsix.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run verify:boundaries && bun run test:unit && bun run build && bun run test:integration"
  },
  "dependencies": {
    "monaco-editor": "0.55.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "xstate": "5.32.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@types/mocha": "10.0.10",
    "@types/node": "18.19.130",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/vscode": "1.86.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "mocha": "11.7.6",
    "oxlint": "1.74.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "contributes": {
    "commands": [
      {
        "command": "nextRecording.start",
        "title": "%nextRecording.start.title%",
        "category": "%nextRecording.category%"
      },
      {
        "command": "nextRecording.stop",
        "title": "%nextRecording.stop.title%",
        "category": "%nextRecording.category%"
      },
      {
        "command": "nextRecording.recover",
        "title": "%nextRecording.recover.title%",
        "category": "%nextRecording.category%"
      },
      {
        "command": "nextRecording.open",
        "title": "%nextRecording.open.title%",
        "category": "%nextRecording.category%"
      },
      {
        "command": "nextRecording.export",
        "title": "%nextRecording.export.title%",
        "category": "%nextRecording.category%"
      }
    ],
    "customEditors": [
      {
        "viewType": "nextRecording.player",
        "displayName": "%nextRecording.player.displayName%",
        "selector": [
          {
            "filenamePattern": "*.nextrecording"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nextRecording.start",
          "when": "!nextRecording.isRecording && !nextRecording.isPreparing && !nextRecording.isStopping"
        },
        {
          "command": "nextRecording.stop",
          "when": "nextRecording.isRecording"
        },
        {
          "command": "nextRecording.recover",
          "when": "nextRecording.hasRecoverableSession"
        }
      ]
    },
    "configuration": {
      "title": "Next Recording",
      "properties": {
        "nextRecording.capture.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns (matched against the root-relative path and file name) for documents that must never be captured. Read when a recording starts."
        },
        "nextRecording.capture.maxDocumentBytes": {
          "type": "number",
          "default": 10485760,
          "minimum": 1024,
          "maximum": 20971520,
          "markdownDescription": "Documents larger than this (UTF-8 bytes) are excluded from capture. Read when a recording starts."
        },
        "nextRecording.capture.includeUntitled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Capture untitled documents. Read when a recording starts."
        },
        "nextRecording.capture.includeRemote": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Capture remote/virtual documents. Read when a recording starts."
        },
        "nextRecording.playback.defaultSpeed": {
          "type": "number",
          "default": 1,
          "enum": [
            0.5,
            1,
            1.5,
            2
          ],
          "markdownDescription": "Initial playback speed for newly opened recordings."
        },
        "nextRecording.diagnostics.level": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "debug"
          ],
          "default": "off",
          "markdownDescription": "Diagnostic logging level for the Next Recording output channel. Logs never contain captured source text."
        }
      }
    }
  },
  "activationEvents": [],
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.86.0"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Text documents in virtual workspaces can be recorded; recordings are always stored on the local machine."
    },
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension never executes workspace code. It records visible text documents and replays recordings in a read-only player."
    }
  }
}
