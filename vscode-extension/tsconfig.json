{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    // The editor's tsserver matches .tsx files under src/webview to this
    // base config (it never auto-discovers tsconfig.webview.json), so JSX
    // must be enabled here too; the host/test configs include no .tsx and
    // are unaffected.
    "jsx": "react-jsx"
  }
}
