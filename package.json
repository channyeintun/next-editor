    "build": "tsc -b tsconfig.json && vp build",
    "build:wasm": "node scripts/build-dmp-wasm.mjs",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test watch",
    "format": "vp lint --fix",
    "lint": "vp lint",
    "typecheck": "tsc -b tsconfig.json",
    "benchmark:dmp-codec": "node scripts/benchmark-dmp-codec.mjs",
    "measure:recording": "node scripts/measure-recording-size.mjs",
    "preview": "vp preview",
    "prepare": "vp config --hooks-only"
  },
