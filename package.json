    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-wasm": "^3.6.0",
    "vite-plus": "1.0.0-rc.1",
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1"
  },
  "packageManager": "bun@1.3.13"
}
