{
  "name": "next-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "dev:worker": "wrangler dev --config infra/wrangler.toml --port 8787",
