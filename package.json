{
  "name": "next-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "dev:worker": "wrangler dev --config infra/wrangler.toml --port 8787",
    "dev:all": "bun run dev & bun run dev:worker & wait",
    "d1:migrate:local": "wrangler d1 migrations apply next-editor-tube --local --config infra/wrangler.toml",
    "build": "bun run typecheck && vp build",
    "build:wasm": "node scripts/build-dmp-wasm.mjs",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test watch",
    "format": "vp lint --fix",
    "lint": "vp lint",
    "typecheck": "tsc -b tsconfig.json infra/worker/tsconfig.json",
    "benchmark:dmp-codec": "bun scripts/benchmark-dmp-codec.ts",
    "measure:recording": "bun scripts/measure-recording-size.ts",
    "preview": "vp preview",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/noto-sans-myanmar": "5.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@openrouter/agent": "^0.11.0",
    "@rrweb/record": "2.2.2",
    "@rrweb/replay": "2.2.2",
    "@rrweb/types": "2.2.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@upstash/qstash": "^2.12.1",
    "@webcontainer/api": "^1.6.4",
    "@xstate/react": "^6.1.0",
    "@xstate/store-react": "^2.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.21.1",
    "comlink": "^4.4.2",
    "driver.js": "^1.11.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "lib0": "0.2.120",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "partytracks": "0.0.56",
    "posthog-js": "^1.447.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "rxjs": "7.8.2",
    "source-code-pro": "2.42.0",
    "xstate": "5.33.4",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@posthog/plugin-utils": "^2.0.1",
    "@posthog/rollup-plugin": "^1.6.3",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "monaco-editor": "^0.57.0",
