{
  "name": "next-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "dev:worker": "wrangler dev --config infra/wrangler.toml --port 8787",
    "dev:all": "bun run dev & bun run dev:worker & wait",
    "d1:migrate:local": "wrangler d1 migrations apply next-editor-tube --local --config infra/wrangler.toml",
    "build": "bun run typecheck && vp build",
    "build:wasm": "node scripts/build-dmp-wasm.mjs",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test watch",
    "format": "vp lint --fix",
    "lint": "vp lint",
    "typecheck": "tsc -b tsconfig.json infra/worker/tsconfig.json",
    "benchmark:dmp-codec": "node scripts/benchmark-dmp-codec.mjs",
    "measure:recording": "node scripts/measure-recording-size.mjs",
    "preview": "vp preview",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@msgpack/msgpack": "^3.1.3",
    "@openrouter/agent": "^0.11.0",
    "@posthog/react": "^1.11.2",
    "@rrweb/record": "2.1.6",
    "@rrweb/replay": "2.1.6",
    "@rrweb/types": "2.1.6",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@upstash/qstash": "^2.11.3",
    "@webcontainer/api": "^1.6.4",
    "@xstate/react": "^6.1.0",
    "@xstate/store-react": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "comlink": "^4.4.2",
    "driver.js": "^1.8.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "lib0": "0.2.118",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "partytracks": "0.0.56",
    "posthog-js": "^1.434.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rxjs": "7.8.2",
    "xstate": "5.33.2",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@posthog/rollup-plugin": "^1.6.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "27.4.0",
    "monaco-editor": "^0.57.0",
    "onnxruntime-web": "1.30.0",
    "oxlint-tailwindcss": "^1.13.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "rolldown": "^1.2.11",
