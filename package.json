{
  "name": "next-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "dev:worker": "wrangler dev --config infra/wrangler.toml --port 8787",
    "dev:all": "bun run dev & bun run dev:worker & wait",
    "d1:migrate:local": "wrangler d1 migrations apply next-editor-tube --local --config infra/wrangler.toml",
    "build": "tsc -b tsconfig.json && vp build",
    "build:wasm": "node scripts/build-dmp-wasm.mjs",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test watch",
    "format": "vp lint --fix",
    "lint": "vp lint",
    "typecheck": "tsc -b tsconfig.json",
    "benchmark:dmp-codec": "node scripts/benchmark-dmp-codec.mjs",
    "measure:recording": "node scripts/measure-recording-size.mjs",
    "preview": "vp preview",
    "prepare": "vp config --hooks-only"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@upstash/redis": "^1.38.0",
    "@webcontainer/api": "^1.6.4",
    "@xstate/react": "^6.1.0",
    "@xstate/store-react": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.18.1",
    "comlink": "^4.4.2",
    "driver.js": "^1.6.0",
    "fflate": "^0.8.3",
    "hono": "^4.12.28",
    "lucide-react": "^0.562.0",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "rrweb": "^2.1.0",
    "xstate": "5.32.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^27.4.0",
    "monaco-editor": "^0.55.1",
    "oxlint": "^1.73.0",
    "oxlint-tailwindcss": "^1.3.4",
    "postcss": "^8.5.16",
    "rolldown": "^1.1.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-checker": "^0.14.4",
    "vite-plugin-wasm": "^3.6.0",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.109.0"
  },
  "packageManager": "bun@1.3.13"
}
