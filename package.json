    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plugin-wasm": "^3.6.0",
    "vite-plus": "1.5.1",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1"
  },
  "packageManager": "bun@1.4.4"
}
