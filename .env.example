# Copy to .env and fill in. Vite bakes VITE_* vars into the client bundle at
# build time (bun run build), so these must be present on whichever machine
# builds for production — there is no Cloudflare-side runtime env for them.
# The PostHog project token is public by design (it ships in the JS bundle);
# find it in PostHog → Project Settings.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Direct Monaco/Yjs binding is enabled unless explicitly disabled.
VITE_COLLABORATION_Y_MONACO=true

# Build-time only, never bundled. vite.config.ts uploads source maps to PostHog
# and deletes them from dist/, and its PostHog plugin refuses to load without a
# project ID and a personal API key — so `vp dev`, `vp test`, and `vp build` all
# need these two set. Placeholders are enough for dev and tests; a production
# build uploads the maps and needs the real values. The personal API key is a
# secret, unlike the project token above. POSTHOG_HOST defaults to
# https://us.i.posthog.com.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=
